{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lite-markdown",
  "version": "0.1.0",
  "identifier": "com.lite-markdown.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lite-markdown",
        "width": 1000,
        "height": 700,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDQkMzRkIxMTU1MTIwMzAKUldRd0lGRVZzVCs4elBCanY3RDBHR0xjd3U2V0xxWVcwUXJSM3VvWjRHQlBGM1ZiSUo5c0dIRXgK",
      "endpoints": [
        "https://github.com/ydaigo/lite-markdown/releases/download/nightly/latest.json"
      ]
    }
  }
}
